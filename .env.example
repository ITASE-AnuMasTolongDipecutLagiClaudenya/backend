PORT=8080
FRONTEND_URL=http://localhost:8443
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Comma-separated keys; requests rotate across all configured keys. Gemini powers OCR and Google Search-grounded nutrition estimates.
GEMINI_API_KEYS=YOUR_GEMINI_KEY_1,YOUR_GEMINI_KEY_2,YOUR_GEMINI_KEY_3,YOUR_GEMINI_KEY_4,YOUR_GEMINI_KEY_5,YOUR_GEMINI_KEY_6
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEYS=YOUR_GROQ_KEY_1,YOUR_GROQ_KEY_2,YOUR_GROQ_KEY_3,YOUR_GROQ_KEY_4,YOUR_GROQ_KEY_5,YOUR_GROQ_KEY_6
# Stable production model; available within Groq Free Plan limits.
GROQ_MODEL=openai/gpt-oss-20b
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Configure the real secret from Cloudflare Turnstile for deployment.
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
# Google OAuth Client ID/Secret are configured in Supabase Auth Providers, not in this API.
# Cloudflare Turnstile: create a widget for localhost and production domains; set the site key in ../nutrily/.env.
