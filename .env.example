PORT=8080
FRONTEND_URL=http://localhost:8443
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Comma-separated keys; requests rotate across all configured keys. Gemini powers chat image analysis and nutrition advice.
GEMINI_API_KEYS=YOUR_GEMINI_KEY_1,YOUR_GEMINI_KEY_2
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEYS=YOUR_GROQ_KEY_1,YOUR_GROQ_KEY_2
# Stable production model; available within Groq Free Plan limits.
GROQ_MODEL=openai/gpt-oss-20b
# OpenAI powers scan OCR and web-search-grounded nutrition lookup.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
# Exa powers the sourced nutrition lookup for confirmed scan items.
EXA_API_KEY=YOUR_EXA_API_KEY
EXA_NUM_RESULTS=3
EXA_TRUSTED_DOMAINS=fatsecret.co.id,fatsecret.com,ceklist.id,id.openfoodfacts.org,openfoodfacts.org,nutrinusa.id,nutritionix.com,myfitnesspal.com,kalorier.com,hasilpangan.com,*.go.id,*.kemenkes.go.id,*.ac.id,*.co.id
# Spam/budget controls for the OCR + search pipeline.
SCAN_SEARCH_MAX_RESULTS=5
SCAN_DAILY_QUOTA=200
SCAN_MONTHLY_QUOTA=5000
PRODUCT_CACHE_MAX_AGE=720h
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Configure the real secret from Cloudflare Turnstile for deployment.
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
# Google OAuth Client ID/Secret are configured in Supabase Auth Providers, not in this API.
# Cloudflare Turnstile: create a widget for localhost and production domains; set the site key in ../nutrily/.env.
